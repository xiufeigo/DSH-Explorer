{
  "name": "dsh-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Explorer — OpenCode 风格文件树 / 编辑 / 预览 / 审查 / 上下文 / ToDo 面板插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/smoke.mjs",
    "plugin:install": "node scripts/install.mjs",
    "plugin:uninstall": "node scripts/uninstall.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
