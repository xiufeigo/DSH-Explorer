{
  "name": "dsh-explorer",
  "version": "0.1.5-rc.1.0",
  "private": true,
  "description": "DSH Explorer — 会话头终端面板 + 左侧栏工作区排序/置顶（精简版，对齐 DSH 0.1.5-rc.1）",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/smoke.mjs",
    "plugin:install": "node scripts/install.mjs",
    "plugin:uninstall": "node scripts/uninstall.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
